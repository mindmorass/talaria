# Talaria configuration. Copy to a local env file and fill in. NEVER commit it.
# Read by the `talaria` binary (dispatcher on A, runner on C).

# --- transport (both roles) ---
# Production MUST be wss:// (TLS) through the reverse proxy. A local nats:// is
# only for testing against a local server.
TALARIA_NATS_URL=wss://b.example.com/talaria

# Auth to NATS — use ONE of these (matches deploy/nats.conf users):
#   dispatcher on A:  TALARIA_NATS_USER=dispatcher  TALARIA_NATS_PASS=...
#   runner on C:      TALARIA_NATS_USER=runner      TALARIA_NATS_PASS=...
TALARIA_NATS_USER=
TALARIA_NATS_PASS=
# Or a token / creds file instead:
# TALARIA_NATS_TOKEN=
# TALARIA_NATS_CREDS=/path/to/role.creds

# --- end-to-end encryption keys (generate with: talaria keygen) ---
# This machine's PRIVATE key (base64). Keep secret; never leaves this machine.
TALARIA_SELF_PRIV=
# The PEER's PUBLIC key (base64). A holds C's pub; C holds A's pub.
TALARIA_PEER_PUB=

# --- runner-side limits (optional) ---
# Inline response body cap in bytes. Keep comfortably under NATS max_payload
# after base64 (x1.333) + seal overhead. Default 716800 (~700 KiB).
# TALARIA_MAX_BODY=716800
# Response retention in the RESPONSES stream (how long A can collect late).
# TALARIA_RESP_TTL=1h

# --- B deployment (docker-compose, NOT read by the binary) ---
# TALARIA_DISPATCHER_PASS=
# TALARIA_RUNNER_PASS=
